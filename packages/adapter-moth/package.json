{
  "name": "@noxscope/adapter-moth",
  "version": "0.1.0",
  "description": "Read-only canonical Adapter for the Moth daemon state contract",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/awjreynolds/noxscope.git",
    "directory": "packages/adapter-moth"
  },
  "homepage": "https://github.com/awjreynolds/noxscope#readme",
  "bugs": {
    "url": "https://github.com/awjreynolds/noxscope/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "main": "./dist/index.js",
