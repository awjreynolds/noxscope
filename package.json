{
  "name": "noxscope",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/awjreynolds/noxscope.git"
  },
  "homepage": "https://github.com/awjreynolds/noxscope#readme",
  "bugs": {
    "url": "https://github.com/awjreynolds/noxscope/issues"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.33.0"
  },
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "verify:metadata": "node scripts/verify-package-metadata.mjs",
    "verify:provenance": "node scripts/verify-provenance.mjs",
    "verify:fixtures": "node scripts/scan-recording-fixtures.mjs",
    "verify:packages": "node scripts/verify-package-content.mjs",
    "verify": "pnpm verify:metadata && pnpm verify:provenance && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify:fixtures && pnpm verify:packages"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
